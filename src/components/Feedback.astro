---
import BrandIcon from './BrandIcon.astro';
/**
 * 「役に立ちましたか？」フィードバック。
 * クリックで aria-pressed 更新＋お礼表示し、計測基盤（track）へ helpful を送信する。
 */
interface Props {
  article?: string;
}
const { article } = Astro.props;
---
<section class="feedback" data-feedback data-article={article}>
  <p class="feedback__q">この記事は役に立ちましたか？</p>
  <div class="feedback__btns" role="group" aria-label="この記事の評価">
    <button type="button" class="feedback__btn" data-fb="yes" aria-pressed="false">
      <BrandIcon name="check" size={16} /> はい
    </button>
    <button type="button" class="feedback__btn" data-fb="no" aria-pressed="false">
      いいえ
    </button>
  </div>
  <p class="feedback__thanks" hidden>フィードバックをありがとうございます。</p>
</section>

<script>
  import { track } from '../lib/track';
  document.querySelectorAll<HTMLElement>('[data-feedback]').forEach((el) => {
    const thanks = el.querySelector<HTMLElement>('.feedback__thanks');
    const article = el.getAttribute('data-article') ?? undefined;
    const btns = el.querySelectorAll<HTMLButtonElement>('[data-fb]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (thanks) thanks.hidden = false;
        track('feedback', { article, helpful: btn.getAttribute('data-fb') === 'yes' });
      });
    });
  });
</script>
