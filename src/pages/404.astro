---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { url } from '../lib/url';
---
<BaseLayout
  title="ページが見つかりません"
  description="お探しのページは見つかりませんでした。"
  noindex={true}
>
  <section class="section" style="text-align:center;">
    <div class="container" style="max-width: var(--maxw-prose);">
      <p class="hero__eyebrow">404 Not Found</p>
      <h1 class="article-title" style="margin-top:.6rem;">ページが見つかりませんでした</h1>
      <p style="color:var(--muted); margin-top:.8rem;">
        お探しのページは削除されたか、URLが変更された可能性があります。<br />
        キーワード検索やトップページからお探しください。
      </p>
      <div style="margin-top:1.8rem;"><SearchForm /></div>
      <div style="margin-top:1.8rem;">
        <a class="btn btn--primary" href={url('/')}><BrandIcon name="arrow-left" /> トップへ戻る</a>
      </div>
    </div>
  </section>
</BaseLayout>
