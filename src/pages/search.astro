---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { url } from '../lib/url';

// ベースパスを正しく付与（BASE_URL は末尾スラッシュ無しのことがあるため url() で正規化）
const pagefindBundle = url('/pagefind/'); // 例: "/support-faq/pagefind/"
---
<BaseLayout title="検索" description="よくあるご質問の中を検索します。" noindex={true}>
  <link rel="stylesheet" href={`${pagefindBundle}pagefind-ui.css`} slot="head" />

  <section class="section section--tight">
    <div class="container" style="max-width: var(--maxw-prose);">
      <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '検索' }]} />
      <div class="page-head">
        <h1 class="page-head__title">FAQ内を検索</h1>
        <p class="page-head__desc">キーワードを入力すると、該当するご質問が表示されます。</p>
      </div>
      <div id="search"></div>
      <p class="empty" id="search-fallback" hidden>
        検索インデックスは本番ビルド（<code>npm run build</code>）で生成されます。<br />
        ローカルで検索を試すには <code>npm run build</code> の後に <code>npm run preview</code> を実行してください。
      </p>
    </div>
  </section>

  <script src={`${pagefindBundle}pagefind-ui.js`} is:inline></script>
  <script is:inline define:vars={{ bundlePath: pagefindBundle }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') {
        // 検索インデックス未生成（dev で未ビルドなど）
        const fb = document.getElementById('search-fallback');
        if (fb) fb.hidden = false;
        return;
      }
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q') || '';
      new PagefindUI({
        element: '#search',
        bundlePath: bundlePath,
        showSubResults: true,
        showImages: false,
        pageSize: 8,
        resetStyles: false,
        translations: {
          placeholder: 'キーワードで検索',
          clear_search: 'クリア',
          load_more: 'さらに表示',
          search_label: 'FAQを検索',
          filters_label: '絞り込み',
          zero_results: '「[SEARCH_TERM]」に一致する記事が見つかりませんでした',
          many_results: '「[SEARCH_TERM]」の検索結果 [COUNT] 件',
          one_result: '「[SEARCH_TERM]」の検索結果 [COUNT] 件',
          alt_search: '「[SEARCH_TERM]」の結果はありません。「[DIFFERENT_TERM]」の結果を表示しています',
          search_suggestion: '「[SEARCH_TERM]」に一致する記事がありません。別のキーワードをお試しください',
          searching: '「[SEARCH_TERM]」を検索中…',
        },
      });
      if (q) {
        const input = document.querySelector('#search .pagefind-ui__search-input');
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    });
  </script>

  <script>
    // 検索の計測: 検索語・件数・ゼロ件（PagefindUI の描画を監視）＋ 結果クリック。
    import { track } from '../lib/track';
    const root = document.getElementById('search');
    if (root) {
      let lastLogged = '';
      let timer: number | undefined;
      const currentQuery = () =>
        (root.querySelector('.pagefind-ui__search-input') as HTMLInputElement | null)?.value.trim() ?? '';
      const logSearch = () => {
        const q = currentQuery();
        if (!q) return;
        const msg = root.querySelector('.pagefind-ui__message')?.textContent ?? '';
        const zero = /見つかりません/.test(msg);
        const m = msg.replace(/,/g, '').match(/(\d+)\s*件/);
        const count = zero ? 0 : m ? Number(m[1]) : root.querySelectorAll('.pagefind-ui__result').length;
        const key = `${q}|${count}`;
        if (key === lastLogged) return;
        lastLogged = key;
        track('search', { query: q, result_count: count, zero_result: zero });
      };
      const observer = new MutationObserver(() => {
        window.clearTimeout(timer);
        timer = window.setTimeout(logSearch, 700);
      });
      observer.observe(root, { childList: true, subtree: true });
      root.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a') as HTMLAnchorElement | null;
        if (!a || !a.href.includes('/faq/')) return;
        let article = a.getAttribute('href') ?? '';
        const mm = article.match(/\/faq\/([^/?#]+)/);
        if (mm) article = mm[1];
        track('result_click', { query: currentQuery(), article });
      });
    }
  </script>
</BaseLayout>
